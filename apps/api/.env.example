# Business OS API — ortam degiskenleri
#
# Bu dosya commit'lenir, .env ASLA commit'lenmez (DEVELOPMENT_RULES 8).
# Tum degiskenler acilista Zod ile dogrulanir; eksik/hatali deger surecin
# BASLAMAMASINA yol acar (infrastructure/config/env.schema.ts).

NODE_ENV=development
PORT=3001
APP_VERSION=0.1.0

# Runtime baglantisi: businessos_app rolu — yalnizca DML, tablo sahibi degil.
# ARCHITECTURE 3.3: uygulama tablo sahibi rolu ile baglanirsa RLS bypass edilir.
DATABASE_URL=postgresql://businessos_app:businessos_app_dev@localhost:5432/business_os
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Migration baglantisi: businessos_owner rolu — DDL yetkisi var.
# Yalnizca drizzle-kit tarafindan kullanilir, uygulama runtime'i bu URL'i gormez.
DATABASE_MIGRATION_URL=postgresql://businessos_owner:businessos_owner_dev@localhost:5432/business_os

LOG_LEVEL=debug
LOG_PRETTY=true

# Virgulle ayrilmis liste. Bos ise CORS kapali.
CORS_ORIGINS=http://localhost:3000

# Varsayilani KAPALI'dir (fail-closed). Gelistirmede acikca aciyoruz.
SWAGGER_ENABLED=true
