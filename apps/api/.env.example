# Business OS API — ortam degiskenleri
#
# Bu dosya commit'lenir, .env ASLA commit'lenmez (DEVELOPMENT_RULES 8).
# Tum degiskenler acilista Zod ile dogrulanir; eksik/hatali deger surecin
# BASLAMAMASINA yol acar (infrastructure/config/env.schema.ts).

NODE_ENV=development
PORT=3001
APP_VERSION=0.1.0

# Runtime baglantisi: businessos_app rolu — yalnizca DML, tablo sahibi degil.
# ARCHITECTURE 3.3: uygulama tablo sahibi rolu ile baglanirsa RLS bypass edilir.
DATABASE_URL=postgresql://businessos_app:businessos_app_dev@localhost:5432/business_os
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Migration baglantisi: businessos_owner rolu — DDL yetkisi var.
# Yalnizca drizzle-kit tarafindan kullanilir, uygulama runtime'i bu URL'i gormez.
DATABASE_MIGRATION_URL=postgresql://businessos_owner:businessos_owner_dev@localhost:5432/business_os

LOG_LEVEL=debug
LOG_PRETTY=true

# Virgulle ayrilmis liste. Bos ise CORS kapali.
# Web istemcisi (apps/web) baska bir origin'dir (:3000) ve auth cagrilari
# `credentials: 'include'` ile refresh cookie'sini tasir (ADR-0026); bu yuzden
# web origin'i BURADA olmali, aksi halde tarayici credential'li istegi bloklar.
CORS_ORIGINS=http://localhost:3000

# Varsayilani KAPALI'dir (fail-closed). Gelistirmede acikca aciyoruz.
SWAGGER_ENABLED=true

# --- Identity: JWT imzalama (ADR-0020) ---------------------------------------
# EdDSA (Ed25519). Yalnizca Identity OZEL anahtari tutar; diger servisler acik
# anahtarla YALNIZCA dogrular. `kid` rotasyon icindir.
#
# Anahtarlar base64(PEM) olarak verilir — PEM cok satirlidir ve .env'de satir
# sonlari guvenilir tasinmaz.
#
# Yeni cift uretmek icin (apps/api dizininde):
#   node --input-type=module -e "import {generateKeyPair,exportPKCS8,exportSPKI} from 'jose'; \
#     const k=await generateKeyPair('EdDSA',{extractable:true}); \
#     console.log('JWT_PRIVATE_KEY='+Buffer.from(await exportPKCS8(k.privateKey)).toString('base64')); \
#     console.log('JWT_PUBLIC_KEY='+Buffer.from(await exportSPKI(k.publicKey)).toString('base64'))"
#
# ASAGIDAKI CIFT YALNIZCA GELISTIRME ICINDIR — uretimde ASLA kullanilmaz.
JWT_ISSUER=https://api.businessos.local
JWT_AUDIENCE=businessos-api
JWT_SIGNING_KID=dev-1
JWT_PRIVATE_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1DNENBUUF3QlFZREsyVndCQ0lFSUFLUWdObUZsWVA0bS9NeEpHUEM4SUpOQmR1KytmckVMcVVseU1ZN0MzSW8KLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQ==
JWT_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQWczM0VQcENkdFB5RStzYUcvWWJ0cmRMcVF5cXhBL0xLUE1EU3lZb0tvclE9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQ==

# --- Identity: dogrulama kodu pepper'i (ADR-0019) -----------------------------
# Veritabaninda OLMAYAN sunucu sirri: sizan bir DB tek basina kodlari
# dogrulamaya yetmez. En az 16 karakter.
# Faz 3'te .env; kalici cozum secret manager (Faz 7 — AUTH Ek A/U3).
VERIFICATION_CODE_PEPPER=dev-only-pepper-change-me-32chars

# --- Identity outbox tuketicisi (ADR-0006) ------------------------------------
# Dogrulama kodlarini e-postayla teslim eden arka plan sureci.
# Varsayilan ACIK: kapali oldugunda hicbir sey patlamaz, kullanicilar yalnizca
# kodlarini hic almaz — sessiz bir ariza. Testlerde acikca kapatilir.
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_RELAY_BATCH_SIZE=20

# --- E-posta saglayicisi (ARCHITECTURE 9.3) -----------------------------------
# console = e-posta GONDERMEZ, icerigi (dogrulama kodu dahil) loglar.
#           Yalnizca dev/CI icindir; uretimde baglanmasi P1 ihlalidir ve
#           acilista REDDEDILIR.
# resend  = gercek gonderim. Bu secildiginde RESEND_API_KEY ve EMAIL_FROM
#           ZORUNLUDUR; eksikse surec BASLAMAZ (fail closed).
EMAIL_PROVIDER=console

# Resend API anahtari — bir SIRDIR, varsayilani yoktur.
# https://resend.com/api-keys adresinden uretilir.
RESEND_API_KEY=

# Gonderen adresi. Resend'in dogrulanmis alan adina ait olmalidir;
# `onboarding@resend.dev` yalnizca test icindir ve kendi adresinize gonderir.
EMAIL_FROM=onboarding@resend.dev

# --- Embedding saglayicisi (ADR-0029 §3) -------------------------------------
# fake   = ag cagrisi YOK, deterministik sahte vektor. Dev/CI varsayilani.
#          URETIMDE REDDEDILIR: sir sizdirmaz ama aramayi SESSIZCE islevsiz
#          kilar (calisiyor gorunur, sonuclari anlamsizdir).
# openai = gercek embedding. Bu secildiginde OPENAI_API_KEY ZORUNLUDUR;
#          eksikse surec BASLAMAZ (fail closed).
EMBEDDING_PROVIDER=fake

# OpenAI API anahtari — bir SIRDIR, varsayilani yoktur.
OPENAI_API_KEY=

# Embedding modeli. Cikti boyutu 1536'dir ve `knowledge.note_chunks.embedding`
# kolonu (migration 0011) TAM olarak bu boyuta gore tanimlidir. Modeli
# degistirmek kolonu ve TUM saklanan vektorleri yeniden uretmeyi gerektirir.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Sohbet/completion saglayicisi (ADR-0029 §3) ------------------------------
# EmbeddingPort'tan AYRI yapilandirilir: chat DeepSeek'te, embedding OpenAI'da
# (DeepSeek'in embeddings uc noktasi YOKTUR — canli testle olculdu).
# fake     = ag cagrisi YOK, deterministik sahte cevap. Dev/CI varsayilani.
#            URETIMDE REDDEDILIR (bkz. EMBEDDING_PROVIDER notu).
# deepseek = gercek completion. DEEPSEEK_API_KEY ZORUNLU olur.
LLM_PROVIDER=fake
DEEPSEEK_API_KEY=
# deepseek-chat / deepseek-reasoner 2026-07-24'te emekliye ayrildi.
LLM_MODEL=deepseek-v4-flash

# --- Knowledge retrieval (ADR-0029 §4, ADR-0030 §1.2) -------------------------
# ADR-0030 §1.2 "bu sayi ADR'de SABITLENMEZ" der; token butcesine gore ayarlanir.
KNOWLEDGE_RETRIEVAL_LIMIT=8
# Tekil mesaj sayisi (cift degil). 8 = 4 mesaj cifti.
KNOWLEDGE_HISTORY_MESSAGES=8

# Not listesindeki onizleme uzunlugu (karakter). Liste TAM METIN dondurmez:
# bir not 500.000 karaktere kadar cikabilir ve 20 notun tam govdesi tek yanitta
# megabaytlar demektir. `bodyLength` ile kirpilip kirpilmadigi anlasilir.
KNOWLEDGE_NOTE_PREVIEW_LENGTH=280

# Tek POST /knowledge/reindex cagrisinda onarilacak EN FAZLA not. ASIL frendir:
# oran siniri istek SAYISINI baglar, token harcamasini degil — 10 notluk bir
# onarim onlarca embedding cagrisi olabilir.
KNOWLEDGE_REINDEX_BATCH_SIZE=10

# --- Oran siniri (ADR-0029 §5) ----------------------------------------------
# Kullanici + tenant bazli (IP DEGIL: harcamayi yapan kullanicidir, adres
# degil). Sabit saat penceresi; asilirsa 429 + Retry-After.
#
# Iki eylem AYRI KOVA: /ask payini tuketmek not eklemeyi engellemez.
#
# ⚠️ Bu sinirlar ISTEK SAYISINI baglar, TOKEN HARCAMASINI degil.

# BUTCE — insan gercekten yaklasabilir, soru sormak tekrar edilen bir eylemdir.
KNOWLEDGE_ASK_RATE_LIMIT=30

# SIGORTA — insan saatte 60 anlamli not yazamaz; bu rakama ancak bir istemci
# retry hatasi ya da script ulasir. Yuksek olmasi "not daha ucuz" DEMEK DEGIL:
# 20 parcali bir not 20 embedding cagrisidir.
KNOWLEDGE_NOTES_RATE_LIMIT=60

# --- Gunluk rapor worker'i (ADR-0030 §2) ------------------------------------
# Her tenant'in o gun eklenen notlarindan kisa bir AI ozeti uretir. Teslimat
# YALNIZCA uygulama ici (dashboard karti); e-posta YOK.

DAILY_REPORT_ENABLED=true

# Worker'in NE SIKLIKTA baktigi — raporun URETILME SAATI DEGIL. Saat asagidaki
# DAILY_REPORT_HOUR_UTC'dedir; bu aralik yalnizca "vadesi gelen var mi"
# sorgusunun sikligidir.
DAILY_REPORT_INTERVAL_MS=300000

# Tek turda uretilecek en fazla rapor. Her biri BIR LLM cagrisidir.
DAILY_REPORT_BATCH_SIZE=10

# Raporlarin vadesinin geldigi SABIT UTC saati. Tenant bazli saat dilimi
# KAPSAM DISI. Bu saatten once o gunun raporu uretilmez — aksi halde "gunluk"
# rapor, gunun yalnizca ilk saatlerini ozetlerdi.
DAILY_REPORT_HOUR_UTC=6

# Ozetlenecek pencere (ADR-0030 §2.2: son 24 saat).
DAILY_REPORT_WINDOW_HOURS=24

# ============================================================================
# SOSYAL GIRIS — OAuth (ADR-0053)
# ============================================================================
# ⚠️ YAPILANDIRILMAMIS SAGLAYICI = OLMAYAN SAGLAYICI (§3.3): iki degiskeni de
# yazilmamis bir saglayici registry'ye HIC girmez, ucu 404 doner ve arayuz
# dugmesini HIC cizmez. "Devre disi" diye bir bayrak YOKTUR.
#
# ⚠️ YARIM YAPILANDIRMA SUREC BASLATMAZ: yalnizca ID ya da yalnizca secret
# yazmak env dogrulamasinda REDDEDILIR. Sebep: yarim yapilandirilmis bir
# saglayici sessizce "yok" sayilirdi ve hata hic gorunmezdi.
#
# ⚠️ Konsol kurulum adimlari AUTH_ARCHITECTURE.md Ek C'dedir — ozellikle
# Microsoft'un `xms_edov` opsiyonel claim'i (acilmazsa HER Microsoft
# kullanicisi kod ekranina duser).

# API'nin DISARIDAN gorunen kok adresi. ⚠️ `redirect_uri` BUNDAN turetilir,
# ISTEKTEN DEGIL — istekten (Host basligi) turetmek OAuth'un en klasik acigidir.
# ⚠️ Sondaki egik cizgi YAZILMAZ (cift slash `redirect_uri_mismatch` uretir).
API_PUBLIC_URL=http://localhost:3001

# Callback isini bitirince kullaniciyi buraya yollar. Sabittir; istekten gelen
# hicbir sey bu adresi degistiremez (acik yonlendirme korumasi).
WEB_PUBLIC_URL=http://localhost:3000

# --- Google -----------------------------------------------------------------
# Redirect URI: <API_PUBLIC_URL>/api/v1/auth/oauth/google/callback
# Hukum: `email_verified` claim'inin KENDISI (sektorde en guvenilir claim).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Microsoft --------------------------------------------------------------
# Redirect URI: <API_PUBLIC_URL>/api/v1/auth/oauth/microsoft/callback
# ⚠️ Hukum: YALNIZCA `xms_edov === true`. `email` claim'i TEK BASINA ASLA
# yeterli degildir — nOAuth (2023) tam olarak bunu istismar eder.
# ⚠️ `xms_edov` app registration'da ACILMADIKCA GELMEZ:
#   Entra portal -> uygulama -> Token configuration -> Add optional claim
#   -> Token type: ID -> xms_edov  (portal "taninmiyor" uyarisi verebilir,
#   guvenle yok sayilir; claim desteklenir ve dokumantedir).
# Acilmazsa akis KIRILMAZ, yalnizca HER kullanici bir kez 6 haneli kod girer.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# ⚠️ VARSAYILANI YOKTUR ve olmamalidir: `common` her Entra dizinini VE kisisel
# hesaplari kabul eder. Secenekler: common | organizations | consumers | <GUID>
MICROSOFT_OAUTH_TENANT=common

# --- LinkedIn ---------------------------------------------------------------
# Redirect URI: <API_PUBLIC_URL>/api/v1/auth/oauth/linkedin/callback
# Urun: "Sign In with LinkedIn using OpenID Connect" (Products sekmesi).
# ⚠️ Hukum: `email_verified === true`; alan OPSIYONELDIR ve LinkedIn'in kendi
# dokumantasyonu "tum yanitlarda bulunmayabilir" der — YOKLUGU ONAY DEGILDIR.
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# --- Facebook ---------------------------------------------------------------
# Redirect URI: <API_PUBLIC_URL>/api/v1/auth/oauth/facebook/callback
# ⚠️ Hukum: HER ZAMAN `false` — Meta'nin `claims_supported` listesinde
# `email_verified` YOKTUR ve Graph `/me` boyle bir alan dondurmez. Yani soru
# eksik cevaplanmiyor, PROTOKOL SEVIYESINDE HIC SORULAMIYOR.
# ⚠️ Somut sonucu: her Facebook girisi ILK seferinde kod ekranina duser.
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
