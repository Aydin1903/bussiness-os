# Business OS — kok ortam degiskenleri (docker compose icin)
#
# Bu dosya commit'lenir. Gercek degerler .env icinde tutulur ve ASLA commit'lenmez
# (DEVELOPMENT_RULES 8). Asagidaki parolalar yalnizca lokal gelistirme icindir.

# PostgreSQL superuser — yalnizca container kurulumu icin kullanilir.
POSTGRES_SUPERUSER_PASSWORD=postgres

# Redis parolasi. Faz 1'de uygulama Redis'e BAGLANMAZ; container hazir bekler.
REDIS_PASSWORD=redis
