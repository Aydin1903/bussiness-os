# Workspace paketleri her zaman workspace'ten çözülür — yanlışlıkla registry'den
# aynı isimde bir paket çekilmesini engeller.
link-workspace-packages=true
prefer-workspace-packages=true

# Phantom dependency yasağı: bir paket, package.json'ında yazmadığı bir bağımlılığı
# import edemez. Modül sınırı disiplininin paket seviyesindeki karşılığı.
node-linker=isolated
strict-peer-dependencies=false

engine-strict=true
